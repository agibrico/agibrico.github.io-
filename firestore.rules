rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'atsegillesbrice@gmail.com';
    }

    function ownsExistingDocument() {
      return isSignedIn()
        && resource.data.userId != null
        && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn()
        && request.resource.data.userId != null
        && request.resource.data.userId == request.auth.uid;
    }

    function isPublicCard() {
      let content = resource.data.get('content', {});
      let privacy = content.get('privacy', {});
      return (resource.data.status == 'active' || resource.data.status == 'PUBLISHED')
        && content.get('customVisibility', 'public') == 'public'
        && privacy.get('isPublic', true) == true;
    }

    match /cards/{cardId} {
      // Lecture individuelle publique autorisée uniquement pour une carte active et réellement publique
      allow get: if isPublicCard() || ownsExistingDocument() || isAdmin();

      // Liste des fiches réservée à l'administrateur et au propriétaire
      allow list: if ownsExistingDocument() || isAdmin();

      // Création réservée aux utilisateurs authentifiés
      allow create: if ownsIncomingDocument() || isAdmin();

      // Modification réservée au propriétaire authentifié ou administrateur
      allow update: if (ownsExistingDocument() && ownsIncomingDocument()) || isAdmin();

      // Suppression réservée au propriétaire ou administrateur
      allow delete: if ownsExistingDocument() || isAdmin();
    }

    match /clients/{clientId} {
      // Aucune lecture publique. Lecture/écriture uniquement pour le propriétaire authentifié ou administrateur.
      allow get, list, create, update, delete: if ownsExistingDocument() || isAdmin();
    }
  }
}
