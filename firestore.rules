rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'atsegillesbrice@gmail.com';
    }

    function ownsExistingDocument() {
      return isSignedIn()
        && resource.data.userId != null
        && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn()
        && request.resource.data.userId != null
        && request.resource.data.userId == request.auth.uid;
    }

    function isPublicCard() {
      let content = resource.data.get('content', {});
      let privacy = content.get('privacy', {});
      return (resource.data.status == 'active' || resource.data.status == 'PUBLISHED')
        && privacy.get('isPublic', true) == true;
    }

    match /cards/{cardId} {
      allow get, list, create, update, delete: if ownsExistingDocument() || ownsIncomingDocument() || isAdmin();
    }

    match /publicCards/{publicId} {
      allow get: if isPublicCard() || ownsExistingDocument() || isAdmin();
      allow list: if false;
      allow create, update, delete: if ownsExistingDocument() || ownsIncomingDocument() || isAdmin();
    }

    match /clients/{clientId} {
      allow get, list, update, delete: if ownsExistingDocument() || isAdmin();
      allow create: if ownsIncomingDocument() || isAdmin();
    }
  }
}
