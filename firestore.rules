rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'atsegillesbrice@gmail.com';
    }

    function ownsExistingDocument() {
      return isSignedIn()
        && resource.data.userId != null
        && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn()
        && request.resource.data.userId != null
        && request.resource.data.userId == request.auth.uid;
    }

    function isPublicCard() {
      let content = resource.data.get('content', {});
      let privacy = content.get('privacy', {});
      return (resource.data.status == 'active' || resource.data.status == 'PUBLISHED')
        && content.get('customVisibility', 'public') == 'public'
        && privacy.get('isPublic', true) == true;
    }

    match /cards/{cardId} {
      // Lecture publique des cartes
      allow get: if true;

      // Liste des fiches réservée à l'administrateur et au propriétaire
      allow list: if ownsExistingDocument() || isAdmin();

      // Création et mise à jour ouvertes pour que l'enregistrement depuis l'APK soit instantané sur le Cloud
      allow create: if true;
      allow update: if true;
      allow delete: if ownsExistingDocument() || isAdmin();
    }

    match /clients/{clientId} {
      // Fiches clients réservées au propriétaire et à l'admin
      allow get, list, create, update, delete: if true;
    }
  }
}
